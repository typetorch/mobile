<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed watch notification (inside DecoratedCustomViewStyle). The TextAppearance.Compat.Notification* styles take
     the system's notification text colours, so this reads in dark and light. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:orientation="vertical">

  <TextView
    android:id="@+id/ttl_n_line1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:singleLine="true"
    android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

  <TextView
    android:id="@+id/ttl_n_line2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:singleLine="true"
    android:textAppearance="@style/TextAppearance.Compat.Notification" />
</LinearLayout>
