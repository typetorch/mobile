<?xml version="1.0" encoding="utf-8"?>
<!-- The initial layout (before the first draw) and the last resort when even the built-in widget spec cannot be
     drawn (docs/WIDGET_SPEC.md); every normal state is drawn from the spec. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/ttl_widget_bg"
  android:clipToOutline="true"
  android:padding="8dp">

  <TextView
    android:id="@+id/ttl_w_message"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginEnd="20dp"
    android:layout_marginStart="20dp"
    android:ellipsize="end"
    android:gravity="center"
    android:maxLines="2"
    android:text="@string/ttl_loading"
    android:textColor="@color/ttl_widget_text"
    android:textSize="13sp" />

  <ImageView
    android:id="@+id/ttl_w_refresh"
    android:layout_width="24dp"
    android:layout_height="24dp"
    android:layout_gravity="top|end"
    android:contentDescription="@string/ttl_widget_refresh"
    android:padding="3dp"
    android:src="@drawable/ttl_ic_refresh"
    android:visibility="gone" />
</FrameLayout>
