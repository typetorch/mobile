<?xml version="1.0" encoding="utf-8"?>
<!-- Small widget (2x1): game, CCU, delta, updated time, refresh. Only RemoteViews-safe views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/ttl_widget_bg"
  android:clipToOutline="true"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:paddingStart="12dp"
  android:paddingTop="6dp"
  android:paddingEnd="6dp"
  android:paddingBottom="6dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/ttl_w_name"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:singleLine="true"
      android:textColor="@color/ttl_widget_text2"
      android:textSize="12sp" />

    <ImageView
      android:id="@+id/ttl_w_refresh"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:contentDescription="@string/ttl_widget_refresh"
      android:padding="3dp"
      android:src="@drawable/ttl_ic_refresh" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:orientation="horizontal"
    android:paddingEnd="6dp">

    <TextView
      android:id="@+id/ttl_w_ccu"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:singleLine="true"
      android:textColor="@color/ttl_widget_text"
      android:textSize="22sp" />

    <TextView
      android:id="@+id/ttl_w_delta"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:singleLine="true"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/ttl_w_updated"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:gravity="end"
      android:singleLine="true"
      android:textColor="@color/ttl_widget_text2"
      android:textSize="11sp" />
  </LinearLayout>
</LinearLayout>
