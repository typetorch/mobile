{
  "expo": {
    "name": "TypeTorch",
    "slug": "typetorch",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "typetorch",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0a0a0a",
    "ios": {
      "bundleIdentifier": "dev.typetorch.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.typetorch.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0a0a0a",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "./plugins/with-expo-gl-keep-rules.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#fb7a32",
          "defaultChannel": "milestones"
        }
      ],
      "./plugins/with-js-engine-override.js"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ca57b78e-9ea6-405e-a65a-3d462b8ca33d"
      }
    },
    "owner": "phasenull",
    "updates": {
      "url": "https://u.expo.dev/ca57b78e-9ea6-405e-a65a-3d462b8ca33d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
